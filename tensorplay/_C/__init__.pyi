            >>> tensorplay.combinations(tensor_a, r=3)
            tensor([[1, 2, 3]])
            >>> tensorplay.combinations(tensor_a, with_replacement=True)
            tensor([[1, 1],
                    [1, 2],
                    [1, 3],
                    [2, 2],
                    [2, 3],
