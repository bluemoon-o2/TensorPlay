            >>> tensorplay.remainder(tensorplay.tensor([-3., -2, -1, 1, 2, 3]), 2)
            tensor([ 1.,  0.,  1.,  1.,  0.,  1.])
            >>> tensorplay.remainder(tensorplay.tensor([1, 2, 3, 4, 5]), -1.5)
            tensor([ -0.5000, -1.0000,  0.0000, -0.5000, -1.0000 ])
