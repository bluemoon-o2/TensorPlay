                [ 4,  5,  6]])
        >>> tensorplay.narrow(x, 1, 1, 2)
        tensor([[ 2,  3],
                [ 5,  6],
                [ 8,  9]])
        >>> tensorplay.narrow(x, -1, tensorplay.tensor(-1), 1)
        tensor([[3],
                [6],
                [9]])
